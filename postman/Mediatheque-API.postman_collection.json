    {
      "name": "US-05 Supprimer un livre",
      "description": "Suppression (US-05).",
      "item": [
        {
          "name": "API-14 Supprimer un livre disponible",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 204\", () => pm.response.to.have.status(204));",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/livres/2\", (err, res) => {",
                  "    pm.test(\"Le livre n'existe plus (404)\", () => pm.expect(res.code).to.eql(404));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/livres/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "livres",
                "2"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "API-15 Un livre emprunté ne peut pas être supprimé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Message : Impossible de supprimer un livre emprunté\", () => pm.expect(pm.response.json().erreur).to.eql(\"Impossible de supprimer un livre emprunté\"));"
                ]
